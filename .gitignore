# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python venv and data
.venv/
backend/.venv/
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class

# AI model weights & checkpoints (downloaded automatically at runtime)
*.ckpt
*.pt
*.pth
*.bin
*.onnx
backend/models/*.ckpt
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin
backend/models/*.onnx

# Data, media uploads, and databases
data/
uploads/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.db
*.sqlite
*.sqlite3

backend/build/
backend/dist/
src-tauri/target/

.wayfinder
