{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ExTrack",
  "version": "0.1.0",
  "identifier": "com.robinjesba.extrack",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ExTrack Rehearsal Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../backend/process_track.py",
      "../data/models/BS-Roformer-SW.ckpt",
      "../data/models/BS-Roformer-SW.yaml"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
